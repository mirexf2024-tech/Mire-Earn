rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.balanceETB == 0
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.keys().hasOnly(['uid','displayName','email','referralCode','referredBy','balanceETB','accountStatus','createdAt','country']);
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Wallet balance and account status cannot be changed by the member from the browser.
      allow update, delete: if isAdmin();
    }

    match /taskSubmissions/{submissionId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['uid','taskId','proof','status','createdAt']);
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /withdrawalRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amountETB is number && request.resource.data.amountETB > 0
        && request.resource.data.keys().hasOnly(['uid','amountETB','paymentMethod','accountNumber','accountName','status','createdAt']);
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /publicSettings/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
